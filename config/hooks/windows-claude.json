{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(require('node:os').homedir(),'.local','share','neptune','hook-entry.cjs')).run('claude-session','windows')\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(require('node:os').homedir(),'.local','share','neptune','hook-entry.cjs')).run('name','windows','claude')\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(require('node:os').homedir(),'.local','share','neptune','hook-entry.cjs')).run('worker-stop','windows')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
